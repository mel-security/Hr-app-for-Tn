# ============================================================
# HR CRÉDIT - TEMPLATE DE CONFIGURATION
# ============================================================
# Copiez ce fichier vers config.env et modifiez les valeurs :
#   cp config.env.example config.env
#   nano config.env
# ============================================================

# ===================== DOMAINE & RÉSEAU =====================
DOMAIN=credit.entreprise.tn
APP_PORT=3000
POSTGRES_PORT=5432
VPS_IP=YOUR_VPS_IP

# ===================== CERTIFICATS SSL ======================
LETSENCRYPT_EMAIL=admin@entreprise.tn

# ===================== BASE DE DONNÉES ======================
POSTGRES_HOST=postgres
POSTGRES_DB=hr_credit
POSTGRES_USER=hr_credit_user
POSTGRES_PASSWORD=       # ← OBLIGATOIRE: openssl rand -base64 32
POSTGRES_MAX_CONNECTIONS=50

# ===================== APPLICATION ==========================
JWT_SECRET=              # ← OBLIGATOIRE: openssl rand -hex 64
JWT_EXPIRY_HOURS=24
NODE_ENV=production
APP_NAME=HR Crédit
CURRENCY=TND
CURRENCY_DECIMALS=3

# ===================== ADMIN INITIAL ========================
ADMIN_EMAIL=ali@entreprise.tn
ADMIN_PASSWORD=          # ← OBLIGATOIRE: mot de passe admin
ADMIN_NOM=Ben Salah
ADMIN_PRENOM=Ali

# ===================== PARAMÈTRES MÉTIER ====================
PLAFOND_CREDIT_DEFAUT=3000.000
NOMBRE_MENSUALITES_MAX=12
POURCENTAGE_MAX_SALAIRE=30

# ===================== BACKUPS ==============================
BACKUP_DIR=/opt/hr-credit/backups
BACKUP_RETENTION_DAYS=30
BACKUP_CRON_HOUR=2
BACKUP_CRON_MINUTE=0

# ===================== SSH / SÉCURITÉ VPS ===================
SSH_PORT=2222
DEPLOY_USER=deployer
TIMEZONE=Africa/Tunis

# ===================== LOGS =================================
LOG_LEVEL=info
LOG_DIR=/opt/hr-credit/logs
